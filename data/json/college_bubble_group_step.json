    "pos": "32.96#-21.52",
    "position": 2,
    "chessPosition": 1
  },
  {
    "groupId": 1,
    "step": 10,
    "name": "好学的学徒",
    "text": "§安琪蕾特老师正在给我讲月见草的相关知识！",
