    "pos": "32.22#-21.03",
    "position": 1,
    "chessPosition": -1
  },
  {
    "groupId": 1,
    "step": 2,
    "name": "",
    "text": "§这种花只在夜间绽放，种子还能榨油，常用于调理身体和治疗淤伤。",
    "actorId": 4020006,
    "pos": "32.22#-21.03",
    "position": 1,
    "chessPosition": -1
  },
  {
    "groupId": 1,
    "step": 3,
    "name": "好学的学徒",
    "text": "§原来如此……",
